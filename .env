# Environment Configuration
# Chamber Management System Configuration

# Application Settings
APP_NAME=Chamber Management System
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=data/chambers.db
BACKUP_INTERVAL=3600

# Grafana/Atlas SDK Configuration (Optional)
GRAFANA_URL=
GRAFANA_API_KEY=
ATLAS_SDK_ENDPOINT=
REQUIRE_COMPANY_LOGIN=false
DEVELOPER_OVERRIDE=true

# AWS Configuration (for ada authentication)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Network Configuration
ETHERNET_TIMEOUT=30
SERIAL_TIMEOUT=5
SOCKET_PORT=8765
MULTICAST_GROUP=224.1.1.1

# UI Configuration
UI_THEME=dark
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900
AUTO_REFRESH_INTERVAL=5

# Chamber Defaults
DEFAULT_CHAMBER_TYPES=TVAC,HASS,THERMAL
MAX_CHAMBERS_PER_TYPE=10
TELEMETRY_RETENTION_DAYS=90

# Security
SESSION_TIMEOUT=3600
ENCRYPTION_KEY=development_key_change_in_production
ENABLE_AUDIT_LOG=true

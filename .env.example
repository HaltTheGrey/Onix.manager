# Environment Configuration
# Copy this file to .env and configure your settings

# Application Settings
APP_NAME=Chamber Management System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=data/chambers.db
BACKUP_INTERVAL=3600  # seconds

# Grafana/Atlas SDK Configuration
GRAFANA_URL=https://your-grafana-instance.com
GRAFANA_API_KEY=your_api_key_here
ATLAS_SDK_ENDPOINT=https://atlas-api.example.com
REQUIRE_COMPANY_LOGIN=true
DEVELOPER_OVERRIDE=false

# AWS Configuration (for ada authentication)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Network Configuration
ETHERNET_TIMEOUT=30
SERIAL_TIMEOUT=5
SOCKET_PORT=8765
MULTICAST_GROUP=224.1.1.1

# UI Configuration
UI_THEME=dark
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900
AUTO_REFRESH_INTERVAL=5  # seconds

# Chamber Defaults
DEFAULT_CHAMBER_TYPES=TVAC,HASS,THERMAL
MAX_CHAMBERS_PER_TYPE=10
TELEMETRY_RETENTION_DAYS=90

# Security
SESSION_TIMEOUT=3600  # seconds
ENCRYPTION_KEY=your_encryption_key_here
ENABLE_AUDIT_LOG=true
